+            Map<String,Object> commit=
+                    new LinkedHashMap<>();
+            commit.put("phase","commit");
+            commit.put(
+                    "screen_epoch",
+                    screen.screenEpoch());
+            commit.put(
+                    "screen_seq",
+                    screen.screenSeq());
+            commit.put(
+                    "sync_id",screen.syncId());
+            commit.put(

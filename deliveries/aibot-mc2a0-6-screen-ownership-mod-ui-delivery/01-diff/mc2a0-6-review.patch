+
+            commitSent=true;
+            ownedScreenEpoch=screen.screenEpoch();
+            ownedAdapterId=screen.adapterId();
+            ownedScreenSeq=screen.screenSeq();
+            ownedSyncId=screen.syncId();
+        }

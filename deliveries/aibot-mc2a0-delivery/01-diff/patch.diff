+                item.put("type", Registries.ENTITY_TYPE.getId(entity.getType()).toString());
+                item.put("x", (long) Math.floor(entity.getX())); item.put("y", (long) Math.floor(entity.getY())); item.put("z", (long) Math.floor(entity.getZ()));

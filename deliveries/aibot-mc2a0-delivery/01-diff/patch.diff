+                .thenComparing(c -> (String) c.get("type"))
+                .thenComparingLong(c -> (Long) c.get("x"))
+                .thenComparingLong(c -> (Long) c.get("y"))
+                .thenComparingLong(c -> (Long) c.get("z")));

+                    structure.minX, structure.minY, structure.minZ, structure.maxX, structure.maxY, structure.maxZ,
+                    structure.snapshot.stream().map(cell -> new SnapshotCellEvidence(cell.x(), cell.y(), cell.z(), cell.blockId())).toList()));

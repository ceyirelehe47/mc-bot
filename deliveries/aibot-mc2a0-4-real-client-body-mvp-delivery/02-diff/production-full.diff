+    private static String lastDiagReason="";
+    private static long lastDiagMs;
+
+    /** LIVE 诊断:传感器验证失败时低频汇报中间值,定位 real-client 传感器链路。 */
+    private static void diagReject(ServerPlayerEntity player,

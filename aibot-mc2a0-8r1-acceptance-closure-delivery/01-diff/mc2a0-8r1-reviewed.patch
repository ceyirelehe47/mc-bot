+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+PREVIOUS_BRANCH = "experiment/mc2a0-7ar2-final-closure"
+PREVIOUS_HEAD = "090cd8b5de2bdaeddd1096f64e5238b92faacec5"
+PREVIOUS_AUDIT_BASE = "cb958908a494bf46b00bb24d32cd38f7b98438c7"
+R1_BASE_HEAD = "95f52157ac35db5f700a4e394b7ff699d047dcf6"
+COMPROMISED_HEAD = "57b534d16d5c4d7c05e47a18d78aa552359b6666"
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def close(a: Any, b: Any, tolerance: float = 0.01) -> bool:
+    try:
+        return abs(float(a) - float(b)) <= tolerance
+    except (TypeError, ValueError):
+        return False
+
+
+def nonnegative_int(value: Any) -> int:
+    if isinstance(value, bool):
+        raise ValueError("boolean_is_not_an_integer")
+    return int(value)
+
+
+def previous_attestation_checks(
+    attestation: dict[str, Any],
+    expected_sha256: str,
+    actual_sha256: str,
+) -> dict[str, bool]:
+    audit = attestation.get("audit")
+    checks_map = attestation.get("checks")
+    forbidden = attestation.get("forbidden_ancestors")
+    failed = attestation.get("failed")
+    return {
+        "previous_attestation_sha256_matches":
+            expected_sha256 == actual_sha256,
+        "previous_attestation_version_2":
+            attestation.get("attestation_version") == 2,
+        "previous_attestation_pass":
+            attestation.get("pass") is True,
+        "previous_attestation_branch":
+            attestation.get("branch") == PREVIOUS_BRANCH,
+        "previous_attestation_audited_head":
+            attestation.get("audited_head") == PREVIOUS_HEAD,
+        "previous_attestation_head_after_audit":
+            attestation.get("head_after_audit") == PREVIOUS_HEAD,
+        "previous_attestation_remote_before":
+            attestation.get("remote_head_before") == PREVIOUS_HEAD,
+        "previous_attestation_remote_after":
+            attestation.get("remote_head_after") == PREVIOUS_HEAD,
+        "previous_attestation_worktree_clean_before":
+            attestation.get("worktree_clean_before") is True,
+        "previous_attestation_worktree_clean_after":
+            attestation.get("worktree_clean_after") is True,
+        "previous_attestation_exact_two_secret_files":
+            attestation.get("secret_file_count") == 2,
+        "previous_attestation_forbids_compromised_ancestor":
+            isinstance(forbidden, list) and COMPROMISED_HEAD in forbidden,
+        "previous_attestation_audit_object":
+            isinstance(audit, dict),
+        "previous_attestation_audit_pass":
+            isinstance(audit, dict) and audit.get("pass") is True,
+        "previous_attestation_audit_zero_findings":
+            isinstance(audit, dict) and audit.get("finding_count") == 0,
+        "previous_attestation_audit_head":
+            isinstance(audit, dict) and audit.get("head") == PREVIOUS_HEAD,
+        "previous_attestation_audit_base":
+            isinstance(audit, dict)
+            and audit.get("base") == PREVIOUS_AUDIT_BASE,
+        "previous_attestation_failed_empty":
+            isinstance(failed, list) and failed == [],
+        "previous_attestation_all_internal_checks_true":
+            isinstance(checks_map, dict)
+            and bool(checks_map)
+            and all(value is True for value in checks_map.values()),
+    }
+
+
+def suite_ok(
+    suite: dict[str, Any],
+    *,
+    minimum_tests: int,
+    require_errors: bool = False,
+) -> bool:
+    try:
+        tests = nonnegative_int(suite.get("tests"))
+        failures = nonnegative_int(suite.get("failures"))
+        skipped = nonnegative_int(suite.get("skipped", 0))
+        errors = nonnegative_int(suite.get("errors", 0))
+    except (TypeError, ValueError):
+        return False
+    return (
+        tests >= minimum_tests
+        and failures == 0
+        and errors == 0
+        and (not require_errors or "errors" in suite)
+        and skipped == 0
+    )
+
+
+def count_ok(suite: dict[str, Any], minimum_tests: int) -> bool:
+    try:
+        return (
+            nonnegative_int(suite.get("tests")) >= minimum_tests
+            and nonnegative_int(suite.get("failures")) == 0
+        )
+    except (TypeError, ValueError):
+        return False
+
+

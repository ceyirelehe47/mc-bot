+    /**
+     * R2.1 planner variant of {@link #canObserveCell(AIPlayerEntity, BlockPos)}: the same strict
+     * cell-observation rule (capability gate, perception radius, collider/fluid raycast, MISS or
+     * exact hit on the target cell) evaluated from a hypothetical eye position, so work-pose
+     * selection can prove the bot will see the target AFTER walking to a candidate stand. No
+     * observation rule is relaxed; only the eye the planner evaluates from is substituted.
+     */
+    public static boolean canObserveCellFrom(AIPlayerEntity bot, Vec3d eye, BlockPos pos) {
+        if (CapabilityRuntime.decide(bot, PrivilegedCapability.HIDDEN_BLOCK_SCAN,
+                "observable_cell_query").allowed()) {
+            return true;
+        }
+        int radius = Math.max(1, AIBotConfig.get().perception().radius());
+        if (eye.squaredDistanceTo(pos.toCenterPos()) > (double) radius * radius) {
+            return false;
+        }
+        BlockHitResult hit = bot.getServerWorld().raycast(new RaycastContext(
+                eye, pos.toCenterPos(),
+                RaycastContext.ShapeType.COLLIDER, RaycastContext.FluidHandling.ANY, bot));
+        return hit.getType() == HitResult.Type.MISS
+                || (hit.getType() == HitResult.Type.BLOCK && hit.getBlockPos().equals(pos));
+    }
+
     /**

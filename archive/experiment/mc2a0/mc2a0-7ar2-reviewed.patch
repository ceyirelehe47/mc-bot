+def remote_head(repo: Path, branch: str) -> str:
+    remote_line = run(
+        repo,
+        "ls-remote",
+        "--heads",
+        "origin",
+        f"refs/heads/{branch}",
+    ).stdout.strip()
+    if not remote_line:

+    private static <T> T await(long timeoutMs,java.util.function.Supplier<T> probe)
+            throws Exception {
+        long deadline=System.currentTimeMillis()+timeoutMs;
+        T last;
+        do {
+            last=probe.get();
+            if(last!=null)return last;
+            Thread.sleep(20L);
+        } while(System.currentTimeMillis()<deadline);
+        return last;
+    }
